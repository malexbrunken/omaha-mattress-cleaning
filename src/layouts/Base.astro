---
interface Props { title: string; description: string; path: string; jsonld?: object[]; noindex?: boolean }
const { title, description, path, jsonld = [], noindex = false } = Astro.props;
const canonical = new URL(path, "https://omahamattresscleaning.com").href;
const ogImage = "https://images.unsplash.com/photo-1505693416388-b0346efee535?auto=format&fit=crop&w=1200&q=80";
const org = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://sleepsanitation.com/#business",
  "name": "Sleep Sanitation",
  "legalName": "Sleep Sanitation LLC",
  "url": "https://sleepsanitation.com"
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
  <meta name="theme-color" content="#1a1a1a" />
  <link rel="icon" type="image/png" href="/sleep%20sanitation%20logo.png" />
  {!noindex && <link rel="canonical" href={canonical} />}
  <link rel="sitemap" href="/sitemap.xml" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(org)} />
  {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  <style is:global>
    :root {
      --charcoal: #1a1a1a;
      --charcoal-light: #2a2a2a;
      --cream: #faf9f6;
      --cream-warm: #f3f1ec;
      --gold: #c9a96e;
      --gold-dark: #a88b52;
      --stone: #6e6e6e;
      --stone-light: #9a9a9a;
      --line: #e0ddd6;
      --white: #ffffff;
      --shadow: 0 20px 50px rgba(26, 26, 26, 0.08);
      --shadow-deep: 0 30px 70px rgba(26, 26, 26, 0.14);
      --radius: 14px;
      --radius-lg: 22px;
      --max: 1160px;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      color: var(--charcoal);
      background: var(--cream);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3, h4 {
      margin: 0 0 0.9rem;
      font-family: Georgia, "Times New Roman", ui-serif, serif;
      font-weight: 500;
      line-height: 1.15;
      letter-spacing: -0.02em;
      color: var(--charcoal);
    }

    h1 { font-size: clamp(2.4rem, 5vw, 4.2rem); max-width: 16ch; }
    h2 { font-size: clamp(1.9rem, 3.2vw, 2.8rem); max-width: 22ch; }
    h3 { font-size: clamp(1.2rem, 1.8vw, 1.5rem); }
    p { margin: 0 0 1.1rem; font-size: 1.05rem; color: var(--stone); }

    a { color: inherit; text-decoration: none; }
    img { max-width: 100%; display: block; }

    .container {
      width: min(var(--max), calc(100% - 2.5rem));
      margin: 0 auto;
    }

    .section { padding: 5rem 0; }

    .eyebrow {
      display: inline-block;
      padding: 0.35rem 0.8rem;
      border-radius: 999px;
      border: 1px solid var(--line);
      background: var(--cream-warm);
      color: var(--gold-dark);
      font-size: 0.78rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      font-weight: 700;
      font-family: ui-sans-serif, system-ui, sans-serif;
      margin-bottom: 1.2rem;
    }

    .eyebrow.invert {
      border-color: rgba(255,255,255,0.15);
      background: rgba(255,255,255,0.06);
      color: var(--gold);
    }

    .lead {
      font-size: clamp(1.05rem, 1.4vw, 1.25rem);
      color: var(--stone);
      max-width: 60ch;
    }

    .btn-row {
      display: flex;
      gap: 0.8rem;
      flex-wrap: wrap;
      align-items: center;
      margin-top: 1.8rem;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.9rem 1.6rem;
      border-radius: 999px;
      font-weight: 600;
      font-size: 0.95rem;
      transition: all 0.2s ease;
      border: 1px solid transparent;
      white-space: nowrap;
      cursor: pointer;
      font-family: ui-sans-serif, system-ui, sans-serif;
    }

    .btn-primary {
      background: var(--charcoal);
      color: var(--cream);
      box-shadow: 0 10px 28px rgba(26,26,26,0.18);
    }
    .btn-primary:hover { background: #000; transform: translateY(-1px); }

    .btn-outline {
      background: transparent;
      color: var(--charcoal);
      border-color: var(--line);
    }
    .btn-outline:hover { border-color: var(--stone-light); background: var(--cream-warm); }

    .btn-invert {
      background: var(--cream);
      color: var(--charcoal);
      box-shadow: 0 8px 24px rgba(0,0,0,0.1);
    }
    .btn-invert:hover { transform: translateY(-1px); background: var(--white); }

    @media (max-width: 640px) {
      .btn-row { flex-direction: column; align-items: stretch; }
      .btn { width: 100%; }
    }
  </style>
  <style is:global>
    .prose { max-width: 72ch; }
    .prose h2 { margin-top: 2.2rem; }
    .prose p, .prose li { color: var(--charcoal); line-height: 1.7; }
    .prose a { text-decoration: underline; text-underline-offset: 3px; }
    .facts { background: var(--white); border:1px solid var(--line); border-left:4px solid var(--gold); border-radius: var(--radius); padding: 1.2rem 1.4rem; margin: 1.6rem 0; }
    .facts dt { font-weight:700; margin-top:0.6rem; }
    .facts dd { margin:0.2rem 0 0; color: var(--stone); }
    .note { font-style: italic; color: var(--stone); }
  </style>
</head>
<body>
  <!-- Navigation -->
  <header style="position:sticky; top:0; z-index:1000; background:rgba(250,249,246,0.92); backdrop-filter:blur(14px); border-bottom:1px solid var(--line);">
    <div class="container" style="display:flex; align-items:center; justify-content:space-between; min-height:72px; gap:1rem;">
      <a href="/" style="display:flex; align-items:center; gap:0.7rem; min-width:0;">
        <div style="width:38px; height:38px; border-radius:10px; background:var(--charcoal); display:grid; place-items:center; color:var(--gold); font-weight:700; font-size:0.9rem; flex-shrink:0;">O</div>
        <div style="display:flex; flex-direction:column; min-width:0;">
          <strong style="font-size:0.95rem; color:var(--charcoal); letter-spacing:-0.01em; white-space:nowrap;">Omaha Mattress Cleaning</strong>
          <span style="font-size:0.78rem; color:var(--stone-light); white-space:nowrap;">& Sanitation</span>
        </div>
      </a>

      <nav aria-label="Primary" style="display:flex; align-items:center; gap:1.4rem; flex-wrap:wrap;">
        <a href="/#upgrade" style="font-size:0.92rem; font-weight:600; color:var(--stone); display:none;" class="nav-link-desktop">Our Method</a>
        <a href="/areas" style="font-size:0.92rem; font-weight:600; color:var(--stone); display:none;" class="nav-link-desktop">Areas We Serve</a>
        <a href="/#process" style="font-size:0.92rem; font-weight:600; color:var(--stone); display:none;" class="nav-link-desktop">Process</a>
        <a href="/#pricing" style="font-size:0.92rem; font-weight:600; color:var(--stone); display:none;" class="nav-link-desktop">Pricing</a>
        <a href="/omaha-homes" style="font-size:0.92rem; font-weight:600; color:var(--stone); display:none;" class="nav-link-desktop">Omaha Homes</a>
        <a href="/allergy-season" style="font-size:0.92rem; font-weight:600; color:var(--stone); display:none;" class="nav-link-desktop">Allergy Season</a>
        <a href="/airbnb-hosts" style="font-size:0.92rem; font-weight:600; color:var(--stone); display:none;" class="nav-link-desktop">Hosts</a>
        <a href="/about" style="font-size:0.92rem; font-weight:600; color:var(--stone); display:none;" class="nav-link-desktop">About</a>
        <a class="btn btn-primary" href="/book" style="padding:0.65rem 1.2rem; font-size:0.88rem;">Book Omaha Service</a>
      </nav>
    </div>
    <style>
      @media (min-width: 780px) { .nav-link-desktop { display:inline !important; } }
    </style>
  </header>
  <main>
    <slot />
  </main>
  <!-- Footer -->
  <footer style="background:#111; color:rgba(250,249,246,0.55); padding: 2.2rem 0; border-top:1px solid rgba(255,255,255,0.06);">
    <div class="container" style="display:flex; justify-content:space-between; gap:1.5rem; flex-wrap:wrap; align-items:center;">
      <div>
        <div style="font-weight:600; color:rgba(250,249,246,0.85); margin-bottom:0.3rem;">Omaha Mattress Cleaning & Sanitation</div>
        <div style="font-size:0.88rem;">Operated by Sleep Sanitation LLC. <a href="/about" style="color:rgba(250,249,246,0.75); text-decoration:underline; text-underline-offset:3px;">About us</a></div>
        <div style="font-size:0.88rem; margin-top:0.3rem;">Monday–Friday, 9am–6pm · Missed calls returned Saturday and Sunday too</div>
      </div>
      <div style="display:flex; gap:1.2rem; flex-wrap:wrap;">
        <a href="https://sleepsanitation.com/privacy-policy" rel="noopener" style="font-size:0.92rem; color:rgba(250,249,246,0.55);">Privacy Policy</a>
        <a href="https://sleepsanitation.com/terms-of-service" rel="noopener" style="font-size:0.92rem; color:rgba(250,249,246,0.55);">Terms of Service</a>
        <a href="/book" style="font-size:0.92rem; color:rgba(250,249,246,0.55);">Book or contact</a>
        <a href="mailto:info@sleepsanitation.com" style="font-size:0.92rem; color:rgba(250,249,246,0.55);">Email Us</a>
      </div>
    </div>
    <div class="container" style="margin-top:1.2rem; padding-top:1.2rem; border-top:1px solid rgba(255,255,255,0.06); font-size:0.85rem; color:rgba(250,249,246,0.4);">
      © {new Date().getFullYear()} Sleep Sanitation. All rights reserved. Serving the Omaha–Council Bluffs metro.
    </div>
  </footer>
  <script>
    // Simple details animation helper for consistent +/- states
    document.querySelectorAll('details').forEach(d => {
      d.addEventListener('toggle', () => {
        const marker = d.querySelector('summary span');
        if (marker) marker.textContent = d.open ? '−' : '+';
      });
    });
  </script>
</body>
</html>
