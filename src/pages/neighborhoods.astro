---
import Base from "../layouts/Base.astro";
import HubFaq from "../components/HubFaq.astro";
import { faqLd } from "../lib/faq";
import { priceText } from "../lib/prices";
import { pageLastmod } from "../lib/lastmod";
type Fm = { frontmatter: { slug: string; name: string; h1: string; answer: string; order: number; draft?: boolean; areaLabel: string } };
const mods = Object.values(import.meta.glob<Fm>("./neighborhoods/*.md", { eager: true }))
  .map((m) => m.frontmatter)
  .filter((f) => !f.draft)
  .sort((a, b) => a.order - b.order);
const faq = [
  { q: "Do you serve Millard, Dundee, Benson, Aksarben and Blackstone?", a: "Yes. Every neighborhood on this hub is inside the City of Omaha and our standard service area, and the price is the same as anywhere else we work." },
  { q: "How much is a multi-bedroom visit?", a: `${priceText.first} for the first mattress, any size, then ${priceText.additionalKing} for each additional king, ${priceText.additionalFullQueen} for each additional full or queen and ${priceText.additionalKids} for each additional kids' bed in the same visit.` },
  { q: "Can you clean a mattress in an older house with narrow stairs?", a: "Yes. We clean the mattress where it sits, so it never has to come down the stairs." },
  { q: "Is the 72-hour bedroom CO₂ test included?", a: "No. It's an optional service, booked on its own or added to a visit, priced by quote. It isn't a medical test." },
];
const jsonld: object[] = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Omaha neighborhoods we serve",
    url: "https://omahamattresscleaning.com/neighborhoods",
    dateModified: pageLastmod("/neighborhoods"),
    hasPart: mods.map((m) => ({ "@type": "Article", headline: m.h1, url: `https://omahamattresscleaning.com/neighborhoods/${m.slug}` })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://omahamattresscleaning.com/" },
      { "@type": "ListItem", position: 2, name: "Knowledge Center", item: "https://omahamattresscleaning.com/knowledge-center" },
      { "@type": "ListItem", position: 3, name: "Omaha neighborhoods", item: "https://omahamattresscleaning.com/neighborhoods" },
    ],
  },
];
jsonld.push(faqLd(faq));
---
<Base title="Omaha Neighborhoods: Millard, Dundee, Benson, Aksarben, Blackstone" description={`Mattress cleaning pages for Omaha neighborhoods: Millard, Dundee and Memorial Park, Benson, Aksarben and Elmwood, and Blackstone. ${priceText.first} first mattress.`} path="/neighborhoods" jsonld={jsonld}>
  <style>
    .dgrid { display:grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap:1rem; margin:1.5rem 0 2.5rem; }
    .dgrid a { display:block; background:var(--white); border:1px solid var(--line); border-top:4px solid var(--gold); border-radius:var(--radius); padding:1.1rem 1.2rem; box-shadow:var(--shadow); color:inherit; }
    .dgrid h3 { margin:0 0 .4rem; font-size:1.1rem; }
    .dgrid p { margin:0; font-size:.9rem; color:var(--stone); }
  </style>
  <section class="section" style="padding-top:3rem;">
    <div class="container prose">
      <p style="font-size:0.9rem;"><a href="/">Home</a> › <a href="/knowledge-center">Knowledge Center</a> › Omaha neighborhoods</p>
      <span class="eyebrow">Omaha neighborhoods</span>
      <h1>Omaha neighborhoods we serve</h1>
      <p class="lead">Where do we clean mattresses inside Omaha? Everywhere, from Millard, an independent town until 1971, to streetcar-era Dundee and Benson, Aksarben Village on the old racetrack, and the Blackstone District. Omaha Mattress Cleaning is operated by Sleep Sanitation. The first mattress is {priceText.first}, any size; see <a href="/pricing">pricing</a>.</p>

      <h2>Which neighborhood pages can you read?</h2>
      <div class="dgrid">
        {mods.map((m) => (
          <a href={`/neighborhoods/${m.slug}`}>
            <h3>{m.name}</h3>
            <p>{m.areaLabel}</p>
          </a>
        ))}
      </div>

      <h2>What stays the same in every neighborhood?</h2>
      <p>Every visit is the same protocol: low-moisture dry vapor steam, HEPA vacuuming and UV-C light treatment, with gloves, shoe booties and equipment disinfected between jobs. Two checks in every visit: the moisture check after the job and the built-in bed mite sensor on our UV-C vacuum. 72-hour bedroom CO₂ testing is optional and priced by quote. Call or text (402) 512-5658.</p>

      <h2>Where do hosts and allergy season fit?</h2>
      <p>Event weekends and lodging taxes are under <a href="/airbnb-hosts">Airbnb hosts</a>. Outdoor pollen and bed mites are under <a href="/allergy-season">allergy season</a>. City and suburb hauler rules are under <a href="/areas">areas we serve</a>.</p>

      <h2>What do these pages leave to Sleep Sanitation?</h2>
      <p>How steam works on foam and what bed mites are is the same in any city, so we link the <a href="https://sleepsanitation.com/knowledge-center">Sleep Sanitation Knowledge Center</a> instead of rewriting it.</p>

      <HubFaq faq={faq} heading="Questions from Omaha neighborhoods" />

      <h2>What don't we know yet?</h2>
      <ul>
        <li>Exact bed counts inside a given house. Tell us when you book.</li>
        <li>Parking and access at a given address. Tell us about alleys, stairs and street parking when you book.</li>
      </ul>

      <h2>What changed on this page?</h2>
      <ul><li>October 22, 2026: hub and first five neighborhood guides published.</li></ul>
      <p><a class="btn btn-primary" href="/book">Book or contact us</a></p>
    </div>
  </section>
</Base>
