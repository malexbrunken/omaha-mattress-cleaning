---
import Base from "../layouts/Base.astro";
import HubFaq from "../components/HubFaq.astro";
import { faqLd } from "../lib/faq";
import { priceText } from "../lib/prices";
type Fm = { frontmatter: { slug: string; h1: string; answer: string; draft?: boolean } };
const order = [
  "getting-rid-of-a-mattress-in-omaha",
  "council-bluffs-vs-omaha-mattress-disposal",
  "bed-bugs-in-douglas-county",
  "humid-summers-and-basement-bedrooms",
  "west-omaha-new-construction-dust",
  "missouri-river-bottom-humidity",
  "offutt-pcs-mattress-reset",
];
const mods = Object.values(import.meta.glob<Fm>("./omaha-homes/*.md", { eager: true }))
  .map((m) => m.frontmatter)
  .filter((f) => !f.draft)
  .sort((a, b) => order.indexOf(a.slug) - order.indexOf(b.slug));
const faq = [
  { q: "How much does mattress cleaning cost in Omaha?", a: `${priceText.first} for the first mattress, any size, with normal stains, pet odor and ordinary urine accidents included. Each additional full, queen or king is ${priceText.additionalLarge}; each additional kids' bed is ${priceText.additionalKids}.` },
  { q: "Can an Omaha mattress go in the trash cart?", a: "No. The Omaha Recycling Guide lists mattresses as a bulky item, so they need a Cleanup Saturday, the River City program or Pheasant Point Landfill." },
  { q: "Do you treat bed bugs?", a: "No. Bed bugs need a licensed pest-control company. We treat the mattress surface and kill bed mites (house dust mites) with steam heat." },
  { q: "When can we use the bed again?", a: "The bed stays unmade until it is dry to the touch, and we run a moisture check after service before we leave. In an Omaha summer, run the air conditioning or a dehumidifier rather than opening the windows." },
];
const jsonld: object[] = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Mattresses and Omaha homes",
    url: "https://omahamattresscleaning.com/omaha-homes",
    dateModified: "2026-10-05",
    hasPart: mods.map((m) => ({ "@type": "Article", headline: m.h1, url: `https://omahamattresscleaning.com/omaha-homes/${m.slug}` })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://omahamattresscleaning.com/" },
      { "@type": "ListItem", position: 2, name: "Knowledge Center", item: "https://omahamattresscleaning.com/knowledge-center" },
      { "@type": "ListItem", position: 3, name: "Omaha homes", item: "https://omahamattresscleaning.com/omaha-homes" },
    ],
  },
];
jsonld.push(faqLd(faq));
---
<Base title="Omaha Homes: Mattress Disposal, Bed Bugs and Humidity" description="Omaha home mattress guides: disposal, bed bugs, humidity, west Omaha new-construction dust, river-bottom humidity and Offutt PCS resets." path="/omaha-homes" jsonld={jsonld}>
  <section class="section" style="padding-top:3rem;">
    <div class="container prose">
      <p style="font-size:0.9rem;"><a href="/">Home</a> › <a href="/knowledge-center">Knowledge Center</a> › Omaha homes</p>
      <span class="eyebrow">Omaha homes</span>
      <h1>Mattresses and Omaha homes</h1>
      <p class="lead">These guides answer Omaha-home questions: which city program takes a mattress, what Council Bluffs does differently, who to call about bed bugs, what July does to a basement bedroom, west Omaha new-construction dust, Missouri river-bottom humidity and Offutt PCS mattress resets. Each one starts with local facts and the source we checked.</p>
      <dl class="facts" aria-label="Omaha facts at a glance">
        <p style="margin:0 0 .4rem; font-weight:700; color:var(--charcoal);">Omaha at a glance, checked October 3, 2026</p>
        <dt>Mattress in the trash cart?</dt><dd>No. Bulky item, drop-off only (<a href="https://www.omaharecyclingguide.org/mattresses" rel="noopener">Omaha Recycling Guide</a>).</dd>
        <dt>Next free drop-off</dt><dd>Fall Cleanup Saturdays: October 3, 10, 17 and 24, 2026, 9 AM to 2 PM (<a href="https://www.wasteline.org/general-information/fall-cleanup/" rel="noopener">Wasteline</a>).</dd>
        <dt>Bed bugs and the county</dt><dd>The Douglas County Health Department's role is education (<a href="https://www.douglascountyhealth.com/environmental/pest-control-nuisances" rel="noopener">DCHD</a>).</dd>
        <dt>Highest dew point</dt><dd>July, average dew point near 66°F at Eppley Airfield (NOAA 1991 to 2020 normals).</dd>
      </dl>
      <h2>Which Omaha home guides can you read?</h2>
      <ul>
        {mods.map((m) => (
          <li><a href={`/omaha-homes/${m.slug}`}><strong>{m.h1}</strong></a>. {m.answer.split(". ")[0]}.</li>
        ))}
      </ul>
      <h2>What do these guides leave to Sleep Sanitation?</h2>
      <p>Cleaning methods, mattress materials, how a mattress dries and bed mites aren't specific to Omaha, so we link to the <a href="https://sleepsanitation.com/knowledge-center">Sleep Sanitation Knowledge Center</a> for them instead of repeating them here.</p>
      <HubFaq faq={faq} heading="Quick answers for Omaha homes" />
      <h2>What don't we know yet?</h2>
      <ul>
        <li>Fees at River City and Pheasant Point beyond what the city publishes. Call before you go.</li>
        <li>Dates for 2027 Cleanup Saturdays, which the city posts once they are set.</li>
      </ul>
      <h2>What changed on this page?</h2>
      <ul><li>October 3, 2026: hub and first four guides published.</li><li>October 4, 2026: section headings rewritten as questions; rental-law content removed from the bed bug guide; phone number added to every page.</li><li>October 5, 2026: added west Omaha new-construction dust, Missouri river-bottom humidity and Offutt PCS mattress reset.</li></ul>
      <p><a class="btn btn-primary" href="/book">Book or contact us</a></p>
    </div>
  </section>
</Base>
