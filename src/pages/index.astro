---
import Base from "../layouts/Base.astro";
const business = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://omahamattresscleaning.com/#business",
  "name": "Omaha Mattress Cleaning & Sanitation",
  "url": "https://omahamattresscleaning.com",
  "image": "https://images.unsplash.com/photo-1505693416388-b0346efee535?auto=format&fit=crop&w=1200&q=80",
  "telephone": "+1-402-512-5658",
  "email": "info@sleepsanitation.com",
  "parentOrganization": { "@id": "https://sleepsanitation.com/#organization" },
  "address": { "@type": "PostalAddress", "addressLocality": "Omaha", "addressRegion": "NE", "addressCountry": "US" },
  "areaServed": ["Omaha","Elkhorn","Papillion","La Vista","Bellevue","Gretna","Ralston","Chalco","Bennington","Waterloo","Valley","Council Bluffs"].map((n) => ({ "@type": "City", "name": n })),
  "serviceType": ["Mattress Cleaning","Mattress Sanitation","Dry Vapor Steam Mattress Treatment","Bed Mite Treatment","Pet Odor and Urine Treatment"],
  "priceRange": "$$",
  "openingHours": "Mo-Fr 09:00-18:00",
  "openingHoursSpecification": { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "09:00", "closes": "18:00" },
  "makesOffer": { "@type": "Offer", "price": "199", "priceCurrency": "USD", "description": "First mattress, any size: limited-time Fall 2026 offer (regular price $249). Normal stains, pet odor and ordinary urine accidents included. Book another cleaning within 7 days of your service and it's also $199." }
};
---
<Base title="Omaha Mattress Cleaning & Sanitation | Dry Vapor Steam, Omaha Metro" description="Omaha mattress cleaning and sanitation with low-moisture dry vapor steam, UV-C light treatment and HEPA vacuuming. $249 first mattress, $199 this fall." path="/" jsonld={[business]}>
    <!-- Hero -->
    <section style="position:relative; overflow:hidden; background:linear-gradient(160deg, #1a1a1a 0%, #2d2d2d 100%); color:var(--cream); padding: 5.5rem 0 4.5rem;">
      <div style="position:absolute; inset:0; opacity:0.35; background:url('https://images.unsplash.com/photo-1505693416388-b0346efee535?auto=format&fit=crop&w=2000&q=80') center/cover no-repeat;"></div>
      <div style="position:absolute; inset:0; background:linear-gradient(to bottom, rgba(26,26,26,0.4), rgba(26,26,26,0.92));"></div>

      <div class="container" style="position:relative; display:grid; grid-template-columns: 1.1fr 0.9fr; gap: 3rem; align-items:center;">
        <div>
          <span class="eyebrow invert">Premium In-Home Sleep Surface Care — Omaha Metro</span>
          <h1 style="color:var(--cream); max-width:14ch;">Omaha Mattress Cleaning, Elevated to Sanitation</h1>
          <p class="lead" style="color:rgba(250,249,246,0.82); max-width:52ch;">
            We clean mattresses with low-moisture dry vapor steam and a white-glove protocol built for the surface you sleep on.
          </p>

          <div style="display:flex; gap:0.6rem; flex-wrap:wrap; margin: 1.4rem 0 0.2rem;">
            <span style="padding:0.5rem 0.85rem; border-radius:999px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12); color:rgba(250,249,246,0.85); font-size:0.88rem; font-weight:600;">Serving Omaha</span>
            <span style="padding:0.5rem 0.85rem; border-radius:999px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12); color:rgba(250,249,246,0.85); font-size:0.88rem; font-weight:600;">Elkhorn</span>
            <span style="padding:0.5rem 0.85rem; border-radius:999px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12); color:rgba(250,249,246,0.85); font-size:0.88rem; font-weight:600;">Papillion</span>
            <span style="padding:0.5rem 0.85rem; border-radius:999px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12); color:rgba(250,249,246,0.85); font-size:0.88rem; font-weight:600;">Bellevue</span>
          </div>

          <p role="note" style="margin:1.4rem 0 0; padding:0.9rem 1.1rem; border-radius:var(--radius); background:rgba(201,169,110,0.14); border:1px solid var(--gold); color:var(--cream); max-width:56ch; font-size:0.98rem; line-height:1.5;">
            <strong>Fall 2026 promotion:</strong> your first mattress is $199 (regular $249). Any additional cleaning scheduled within 7 days of your first service is also $199, so you can see our work first. <a href="#pricing" style="color:var(--gold); font-weight:600;">See what's included</a>
          </p>

          <div class="btn-row">
            <a class="btn btn-invert" href="/book">Reserve Your Omaha Appointment</a>
            <a class="btn" style="background:rgba(255,255,255,0.05); color:var(--cream); border-color:rgba(255,255,255,0.15);" href="#upgrade">See the Difference</a>
          </div>
        </div>

        <div style="position:relative; border-radius:var(--radius-lg); overflow:hidden; border:1px solid rgba(255,255,255,0.08); box-shadow:var(--shadow-deep); background:rgba(255,255,255,0.03);">
          <img src="https://static1.squarespace.com/static/66bb648d39b4bd3ed8b10829/t/6a0d1f30776826732caa79f5/1779244848859/grok-image-15c5cd53-84de-4025-acd5-b1a74ad12eea.png" alt="Luxury bedroom interior in an Omaha metro home with pristine white linens" loading="eager" style="width:100%; height:100%; object-fit:cover; min-height:420px; opacity:0.85;" />
          <div style="position:absolute; bottom:0; left:0; right:0; padding:1.4rem; background:linear-gradient(to top, rgba(26,26,26,0.95), transparent);">
            <strong style="display:block; color:var(--cream); font-size:1.05rem; margin-bottom:0.3rem; font-family: Georgia, serif;">White-glove sleep surface care</strong>
            <span style="color:rgba(250,249,246,0.75); font-size:0.95rem;">Clean-entry discipline. Low-moisture methodology. Built for beds, not floors.</span>
          </div>
        </div>
      </div>

      <style>
        @media (max-width: 1000px) {
          .container[style*="grid-template-columns"] { grid-template-columns: 1fr !important; }
        }
        @media (max-width: 640px) {
          section[style*="padding: 5.5rem"] { padding: 3.5rem 0 3rem !important; }
        }
      </style>
    </section>

    <!-- The Upgrade: Cleaning vs Sanitation -->
    <section class="section" id="upgrade">
      <div class="container">
        <span class="eyebrow">The Upgrade</span>
        <h2>Why Omaha Homeowners Move from Cleaning to Sanitation</h2>
        <p class="lead" style="max-width:65ch;">
          A mattress is not a floor or a sofa, so we don't clean it like one. Here are the questions worth asking any mattress cleaner in Omaha, and how we answer them.
        </p>

        <div style="margin-top:2.5rem; overflow:hidden; border-radius:var(--radius-lg); border:1px solid var(--line); background:var(--white); box-shadow:var(--shadow);">
          <div style="display:grid; grid-template-columns: 1fr 1fr; background:var(--cream-warm); border-bottom:1px solid var(--line);">
            <div style="padding:1.1rem 1.4rem; font-weight:700; font-size:0.9rem; text-transform:uppercase; letter-spacing:0.06em; color:var(--stone); border-right:1px solid var(--line);">Question to Ask Any Provider</div>
            <div style="padding:1.1rem 1.4rem; font-weight:700; font-size:0.9rem; text-transform:uppercase; letter-spacing:0.06em; color:var(--charcoal);">Our Answer</div>
          </div>

          <div style="display:grid; grid-template-columns: 1fr 1fr; border-bottom:1px solid var(--line); align-items:center;">
            <div style="padding:1.1rem 1.4rem; color:var(--stone); font-size:0.98rem; border-right:1px solid var(--line);">What equipment touches the mattress?</div>
            <div style="padding:1.1rem 1.4rem; color:var(--charcoal); font-size:0.98rem; font-weight:500;">Controlled dry vapor steam built for sleep surfaces</div>
          </div>
          <div style="display:grid; grid-template-columns: 1fr 1fr; border-bottom:1px solid var(--line); align-items:center; background:var(--cream);">
            <div style="padding:1.1rem 1.4rem; color:var(--stone); font-size:0.98rem; border-right:1px solid var(--line);">How much water goes in?</div>
            <div style="padding:1.1rem 1.4rem; color:var(--charcoal); font-size:0.98rem; font-weight:500;">Low-moisture dry vapor steam, no soaked padding</div>
          </div>
          <div style="display:grid; grid-template-columns: 1fr 1fr; border-bottom:1px solid var(--line); align-items:center;">
            <div style="padding:1.1rem 1.4rem; color:var(--stone); font-size:0.98rem; border-right:1px solid var(--line);">What does the visit cover beyond stains?</div>
            <div style="padding:1.1rem 1.4rem; color:var(--charcoal); font-size:0.98rem; font-weight:500;">Sleep-surface hygiene, with steam heat that kills bed mites</div>
          </div>
          <div style="display:grid; grid-template-columns: 1fr 1fr; border-bottom:1px solid var(--line); align-items:center; background:var(--cream);">
            <div style="padding:1.1rem 1.4rem; color:var(--stone); font-size:0.98rem; border-right:1px solid var(--line);">Is the mattress its own appointment?</div>
            <div style="padding:1.1rem 1.4rem; color:var(--charcoal); font-size:0.98rem; font-weight:500;">Yes, a dedicated sleep-environment appointment</div>
          </div>
          <div style="display:grid; grid-template-columns: 1fr 1fr; align-items:center;">
            <div style="padding:1.1rem 1.4rem; color:var(--stone); font-size:0.98rem; border-right:1px solid var(--line);">What is left behind?</div>
            <div style="padding:1.1rem 1.4rem; color:var(--charcoal); font-size:0.98rem; font-weight:500;">Heat-forward discipline, minimal residue</div>
          </div>
        </div>

        <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:1.2rem; margin-top:2.5rem;">
          <div style="background:var(--white); border:1px solid var(--line); border-radius:var(--radius); padding:1.5rem; box-shadow:var(--shadow);">
            <div style="width:44px; height:44px; border-radius:12px; background:var(--cream-warm); display:grid; place-items:center; color:var(--gold-dark); font-weight:700; font-size:1rem; margin-bottom:1rem;">01</div>
            <h3 style="font-size:1.15rem; margin-bottom:0.5rem;">Moisture Discipline</h3>
            <p style="font-size:0.97rem; margin:0;">Excess water creates new problems in a mattress. Our low-moisture approach respects the physics of foam, latex, and hybrid cores.</p>
          </div>
          <div style="background:var(--white); border:1px solid var(--line); border-radius:var(--radius); padding:1.5rem; box-shadow:var(--shadow);">
            <div style="width:44px; height:44px; border-radius:12px; background:var(--cream-warm); display:grid; place-items:center; color:var(--gold-dark); font-weight:700; font-size:1rem; margin-bottom:1rem;">02</div>
            <h3 style="font-size:1.15rem; margin-bottom:0.5rem;">Equipment Mindset</h3>
            <p style="font-size:0.97rem; margin:0;">Our equipment is chosen for beds, and our process uses sleep-surface discipline from the moment we enter your home.</p>
          </div>
          <div style="background:var(--white); border:1px solid var(--line); border-radius:var(--radius); padding:1.5rem; box-shadow:var(--shadow);">
            <div style="width:44px; height:44px; border-radius:12px; background:var(--cream-warm); display:grid; place-items:center; color:var(--gold-dark); font-weight:700; font-size:1rem; margin-bottom:1rem;">03</div>
            <h3 style="font-size:1.15rem; margin-bottom:0.5rem;">Protocol Over Speed</h3>
            <p style="font-size:0.97rem; margin:0;">This is not a 20-minute add-on. It is a structured sanitation appointment for the surface that supports a third of your life.</p>
          </div>
        </div>
      </div>
      <style>
        @media (max-width: 860px) {
          div[style*="grid-template-columns: repeat(3"] { grid-template-columns: 1fr !important; }
        }
      </style>
    </section>

    <!-- Omaha Metro Coverage -->
    <section style="background:linear-gradient(180deg, #f3f1ec 0%, var(--cream) 100%); padding: 5rem 0;" id="areas">
      <div class="container">
        <span class="eyebrow">Local Coverage</span>
        <h2>Where We Work in the Omaha Metro</h2>
        <p class="lead" style="max-width:60ch;">
          We travel with our white-glove setup throughout the Omaha–Council Bluffs metro. If you are within the service radius, we bring the same premium standard to your door.
        </p>

        <div style="display:grid; grid-template-columns: repeat(4, 1fr); gap:1rem; margin-top:2.5rem;">
          <a href="/book" style="background:var(--white); border:1px solid var(--line); border-radius:var(--radius); padding:1.2rem 1.3rem; box-shadow:var(--shadow); transition:0.2s; display:block;">
            <h4 style="margin:0 0 0.3rem; font-size:1.05rem;">Dundee</h4>
            <p style="margin:0; font-size:0.9rem; color:var(--stone-light);">Historic homes, premium care</p>
          </a>
          <a href="/book" style="background:var(--white); border:1px solid var(--line); border-radius:var(--radius); padding:1.2rem 1.3rem; box-shadow:var(--shadow); transition:0.2s; display:block;">
            <h4 style="margin:0 0 0.3rem; font-size:1.05rem;">Aksarben Village</h4>
            <p style="margin:0; font-size:0.9rem; color:var(--stone-light);">Midtown modern living</p>
          </a>
          <a href="/book" style="background:var(--white); border:1px solid var(--line); border-radius:var(--radius); padding:1.2rem 1.3rem; box-shadow:var(--shadow); transition:0.2s; display:block;">
            <h4 style="margin:0 0 0.3rem; font-size:1.05rem;">Blackstone District</h4>
            <p style="margin:0; font-size:0.9rem; color:var(--stone-light);">Design-forward residences</p>
          </a>
          <a href="/book" style="background:var(--white); border:1px solid var(--line); border-radius:var(--radius); padding:1.2rem 1.3rem; box-shadow:var(--shadow); transition:0.2s; display:block;">
            <h4 style="margin:0 0 0.3rem; font-size:1.05rem;">West Omaha</h4>
            <p style="margin:0; font-size:0.9rem; color:var(--stone-light);">Family homes & estates</p>
          </a>
          <a href="/areas/elkhorn" style="background:var(--white); border:1px solid var(--line); border-radius:var(--radius); padding:1.2rem 1.3rem; box-shadow:var(--shadow); transition:0.2s; display:block;">
            <h4 style="margin:0 0 0.3rem; font-size:1.05rem;">Elkhorn</h4>
            <p style="margin:0; font-size:0.9rem; color:var(--stone-light);">Fast-growing western edge</p>
          </a>
          <a href="/areas/papillion" style="background:var(--white); border:1px solid var(--line); border-radius:var(--radius); padding:1.2rem 1.3rem; box-shadow:var(--shadow); transition:0.2s; display:block;">
            <h4 style="margin:0 0 0.3rem; font-size:1.05rem;">Papillion</h4>
            <p style="margin:0; font-size:0.9rem; color:var(--stone-light);">Suburban sleep environments</p>
          </a>
          <a href="/areas/la-vista" style="background:var(--white); border:1px solid var(--line); border-radius:var(--radius); padding:1.2rem 1.3rem; box-shadow:var(--shadow); transition:0.2s; display:block;">
            <h4 style="margin:0 0 0.3rem; font-size:1.05rem;">La Vista</h4>
            <p style="margin:0; font-size:0.9rem; color:var(--stone-light);">South metro coverage</p>
          </a>
          <a href="/areas/ralston" style="background:var(--white); border:1px solid var(--line); border-radius:var(--radius); padding:1.2rem 1.3rem; box-shadow:var(--shadow); transition:0.2s; display:block;">
            <h4 style="margin:0 0 0.3rem; font-size:1.05rem;">Ralston</h4>
            <p style="margin:0; font-size:0.9rem; color:var(--stone-light);">Close-knit community homes</p>
          </a>
          <a href="/areas/bellevue" style="background:var(--white); border:1px solid var(--line); border-radius:var(--radius); padding:1.2rem 1.3rem; box-shadow:var(--shadow); transition:0.2s; display:block;">
            <h4 style="margin:0 0 0.3rem; font-size:1.05rem;">Bellevue</h4>
            <p style="margin:0; font-size:0.9rem; color:var(--stone-light);">Offutt corridor & east metro</p>
          </a>
          <a href="/areas/gretna" style="background:var(--white); border:1px solid var(--line); border-radius:var(--radius); padding:1.2rem 1.3rem; box-shadow:var(--shadow); transition:0.2s; display:block;">
            <h4 style="margin:0 0 0.3rem; font-size:1.05rem;">Gretna</h4>
            <p style="margin:0; font-size:0.9rem; color:var(--stone-light);">Southwest corridor estates</p>
          </a>
          <a href="/areas/bennington" style="background:var(--white); border:1px solid var(--line); border-radius:var(--radius); padding:1.2rem 1.3rem; box-shadow:var(--shadow); transition:0.2s; display:block;">
            <h4 style="margin:0 0 0.3rem; font-size:1.05rem;">Bennington</h4>
            <p style="margin:0; font-size:0.9rem; color:var(--stone-light);">Northwest rural luxury</p>
          </a>
          <a href="/book" style="background:var(--white); border:1px solid var(--line); border-radius:var(--radius); padding:1.2rem 1.3rem; box-shadow:var(--shadow); transition:0.2s; display:block;">
            <h4 style="margin:0 0 0.3rem; font-size:1.05rem;">Council Bluffs</h4>
            <p style="margin:0; font-size:0.9rem; color:var(--stone-light);">Across the river in Iowa</p>
          </a>
        </div>

        <div style="margin-top:2rem; padding:1.2rem 1.5rem; background:var(--white); border:1px solid var(--line); border-radius:var(--radius); display:flex; align-items:center; gap:1rem; flex-wrap:wrap;">
          <div style="width:32px; height:32px; border-radius:50%; background:var(--cream-warm); display:grid; place-items:center; color:var(--gold-dark); font-weight:700; font-size:0.85rem; flex-shrink:0;">?</div>
          <p style="margin:0; font-size:0.98rem; color:var(--stone);">Not sure if your address is in our radius? <a href="/book" style="color:var(--charcoal); font-weight:600; text-decoration:underline; text-underline-offset:3px;">Send us your location</a> and we will confirm availability.</p>
        </div>
      </div>
      <style>
        @media (max-width: 900px) {
          div[style*="grid-template-columns: repeat(4"] { grid-template-columns: repeat(2, 1fr) !important; }
        }
        @media (max-width: 520px) {
          div[style*="grid-template-columns: repeat(2"] { grid-template-columns: 1fr !important; }
        }
      </style>
    </section>

    <!-- Process -->
    <section class="section" id="process">
      <div class="container">
        <span class="eyebrow">Our Method</span>
        <h2>A Three-Phase Process Built for Beds</h2>
        <p class="lead" style="max-width:60ch;">
          Our appointment is precise, not rushed. Every phase is designed around the sleep environment of an Omaha metro home.
        </p>

        <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:1.5rem; margin-top:2.5rem;">
          <div style="position:relative; background:var(--white); border:1px solid var(--line); border-radius:var(--radius-lg); padding:2rem 1.8rem; box-shadow:var(--shadow);">
            <div style="position:absolute; top:-16px; left:1.8rem; width:48px; height:48px; border-radius:50%; background:var(--charcoal); color:var(--gold); display:grid; place-items:center; font-weight:700; font-size:1.1rem; box-shadow:0 6px 18px rgba(0,0,0,0.18);">1</div>
            <h3 style="margin-top:1.2rem; margin-bottom:0.7rem;">Assessment & Containment</h3>
            <p style="font-size:0.98rem; margin:0;">We inspect fabric condition, mattress construction, and the surrounding bedroom environment. Technicians wear gloves and shoe booties, and equipment is disinfected between jobs. Tools are staged cleanly. Your home is protected before treatment begins.</p>
          </div>
          <div style="position:relative; background:var(--white); border:1px solid var(--line); border-radius:var(--radius-lg); padding:2rem 1.8rem; box-shadow:var(--shadow);">
            <div style="position:absolute; top:-16px; left:1.8rem; width:48px; height:48px; border-radius:50%; background:var(--charcoal); color:var(--gold); display:grid; place-items:center; font-weight:700; font-size:1.1rem; box-shadow:0 6px 18px rgba(0,0,0,0.18);">2</div>
            <h3 style="margin-top:1.2rem; margin-bottom:0.7rem;">Dry Vapor Steam Treatment</h3>
            <p style="font-size:0.98rem; margin:0;">Controlled dry vapor steam is applied across the sleep surface, with deliberate attention to seams, quilting, edges, and higher-accumulation zones. Low moisture. High discipline.</p>
          </div>
          <div style="position:relative; background:var(--white); border:1px solid var(--line); border-radius:var(--radius-lg); padding:2rem 1.8rem; box-shadow:var(--shadow);">
            <div style="position:absolute; top:-16px; left:1.8rem; width:48px; height:48px; border-radius:50%; background:var(--charcoal); color:var(--gold); display:grid; place-items:center; font-weight:700; font-size:1.1rem; box-shadow:0 6px 18px rgba(0,0,0,0.18);">3</div>
            <h3 style="margin-top:1.2rem; margin-bottom:0.7rem;">Environment Reset</h3>
            <p style="font-size:0.98rem; margin:0;">Tools are broken down orderly. The mattress is left in a cleaner, drier, professionally handled condition. We reset the room so the last impression matches the first.</p>
          </div>
        </div>
      </div>
      <style>
        @media (max-width: 860px) {
          div[style*="grid-template-columns: repeat(3, 1fr)"] { grid-template-columns: 1fr !important; }
        }
      </style>
    </section>

    <!-- Premium Positioning -->
    <section style="background:var(--charcoal); color:var(--cream); padding: 5rem 0;">
      <div class="container">
        <span class="eyebrow invert">Premium Positioning</span>
        <h2 style="color:var(--cream);">A Disciplined Mattress Service for the Metro</h2>
        <p style="color:rgba(250,249,246,0.75); max-width:60ch; font-size:1.08rem;">
          We are not the cheapest mattress cleaning option in Omaha. Here is what the price covers.
        </p>

        <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:1.2rem; margin-top:2.5rem;">
          <div style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08); border-radius:var(--radius); padding:1.6rem;">
            <div style="font-family: Georgia, serif; font-size: clamp(2.2rem, 3vw, 3rem); font-weight:500; color:var(--gold); line-height:1; margin-bottom:0.8rem; letter-spacing:-0.03em;">$249</div>
            <h3 style="color:var(--cream); font-size:1.15rem; margin-bottom:0.4rem;">First Mattress, Any Size</h3>
            <p style="color:rgba(250,249,246,0.65); font-size:0.97rem; margin:0;">Normal stains, pet odor and ordinary urine accidents are included. $199 under the limited-time Fall 2026 offer.</p>
          </div>
          <div style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08); border-radius:var(--radius); padding:1.6rem;">
