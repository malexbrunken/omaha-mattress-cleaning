  <style is:global>
    :root {
      --charcoal: #1a1a1a;
      --charcoal-light: #2a2a2a;
      --cream: #faf9f6;
      --cream-warm: #f3f1ec;
      --gold: #c9a96e;
      --gold-dark: #a88b52;
      --stone: #6e6e6e;
      --stone-light: #9a9a9a;
      --line: #e0ddd6;
      --white: #ffffff;
      --shadow: 0 20px 50px rgba(26, 26, 26, 0.08);
      --shadow-deep: 0 30px 70px rgba(26, 26, 26, 0.14);
      --radius: 14px;
      --radius-lg: 22px;
      --max: 1160px;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      color: var(--charcoal);
      background: var(--cream);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3, h4 {
      margin: 0 0 0.9rem;
      font-family: Georgia, "Times New Roman", ui-serif, serif;
      font-weight: 500;
      line-height: 1.15;
      letter-spacing: -0.02em;
      color: var(--charcoal);
    }

    h1 { font-size: clamp(2.4rem, 5vw, 4.2rem); max-width: 16ch; }
    h2 { font-size: clamp(1.9rem, 3.2vw, 2.8rem); max-width: 22ch; }
    h3 { font-size: clamp(1.2rem, 1.8vw, 1.5rem); }
    p { margin: 0 0 1.1rem; font-size: 1.05rem; color: var(--stone); }

    a { color: inherit; text-decoration: none; }
    img { max-width: 100%; display: block; }

    .container {
      width: min(var(--max), calc(100% - 2.5rem));
      margin: 0 auto;
    }

    .section { padding: 5rem 0; }

    .eyebrow {
      display: inline-block;
      padding: 0.35rem 0.8rem;
      border-radius: 999px;
      border: 1px solid var(--line);
      background: var(--cream-warm);
      color: var(--gold-dark);
      font-size: 0.78rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      font-weight: 700;
      font-family: ui-sans-serif, system-ui, sans-serif;
      margin-bottom: 1.2rem;
    }

    .eyebrow.invert {
      border-color: rgba(255,255,255,0.15);
      background: rgba(255,255,255,0.06);
      color: var(--gold);
    }

    .lead {
      font-size: clamp(1.05rem, 1.4vw, 1.25rem);
      color: var(--stone);
      max-width: 60ch;
    }

    .btn-row {
      display: flex;
      gap: 0.8rem;
      flex-wrap: wrap;
      align-items: center;
      margin-top: 1.8rem;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.9rem 1.6rem;
      border-radius: 999px;
      font-weight: 600;
      font-size: 0.95rem;
      transition: all 0.2s ease;
      border: 1px solid transparent;
      white-space: nowrap;
      cursor: pointer;
      font-family: ui-sans-serif, system-ui, sans-serif;
    }

    .btn-primary {
      background: var(--charcoal);
      color: var(--cream);
      box-shadow: 0 10px 28px rgba(26,26,26,0.18);
    }
    .btn-primary:hover { background: #000; transform: translateY(-1px); }

    .btn-outline {
      background: transparent;
      color: var(--charcoal);
      border-color: var(--line);
    }
    .btn-outline:hover { border-color: var(--stone-light); background: var(--cream-warm); }

    .btn-invert {
      background: var(--cream);
      color: var(--charcoal);
      box-shadow: 0 8px 24px rgba(0,0,0,0.1);
    }
    .btn-invert:hover { transform: translateY(-1px); background: var(--white); }

    @media (max-width: 640px) {
      .btn-row { flex-direction: column; align-items: stretch; }
      .btn { width: 100%; }
    }
  </style>
</head>

