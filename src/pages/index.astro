            <span style="padding:0.5rem 0.85rem; border-radius:999px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12); color:rgba(250,249,246,0.85); font-size:0.88rem; font-weight:600;">Papillion</span>
            <span style="padding:0.5rem 0.85rem; border-radius:999px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12); color:rgba(250,249,246,0.85); font-size:0.88rem; font-weight:600;">Lincoln</span>
