---
/**
 * Knowledge Center index. Lists every hub and every guide, generated from the markdown
 * files under each hub folder, so a new guide shows up here on the next build.
 */
import Base from "../layouts/Base.astro";
import { priceText } from "../lib/prices";
import { PHONE } from "../lib/founder";
import { kcLastmod } from "../lib/lastmod";

type Fm = { slug: string; h1: string; order?: number; draft?: boolean; updated?: string; published?: string };
type Mod = { frontmatter: Fm };
const list = (mods: Record<string, Mod>) =>
  Object.values(mods)
    .map((m) => m.frontmatter)
    .filter((f) => !f.draft)
    .sort((a, b) => (a.order ?? 99) - (b.order ?? 99) || a.h1.localeCompare(b.h1));

const SITE = "https://omahamattresscleaning.com";
const hubs = [
  {
    path: "/omaha-homes",
    q: "What do Omaha homeowners ask about mattresses?",
    name: "Mattresses and Omaha homes",
    blurb: "Mattress disposal, bed bugs, summer humidity, west Omaha new-construction dust, Missouri river-bottom humidity and Offutt PCS resets.",
    guides: list(import.meta.glob<Mod>("./omaha-homes/*.md", { eager: true })),
  },
  {
    path: "/areas",
    q: "Which Omaha suburbs do we serve?",
    name: "Areas we serve",
    blurb: "One page per suburb: trash and bulky-item rules, the health department that covers you, and local housing facts.",
    guides: list(import.meta.glob<Mod>("./areas/*.md", { eager: true })),
  },
  {
    path: "/allergy-season",
    q: "When is allergy season in Omaha?",
    name: "Allergy season in Omaha",
    blurb: "Omaha's pollen calendar, who counts it and when, and how bed mites differ from outdoor pollen.",
    guides: list(import.meta.glob<Mod>("./allergy-season/*.md", { eager: true })),
  },
  {
    path: "/airbnb-hosts",
    q: "How do Omaha hosts plan mattress care?",
    name: "Airbnb and short-term rental hosts",
    blurb: "Event weekends, lodging taxes and scheduling mattress care between guests in the Omaha metro.",
    guides: list(import.meta.glob<Mod>("./airbnb-hosts/*.md", { eager: true })),
  },
  {
    path: "/developments",
    q: "Which named Omaha developments do we serve?",
    name: "Omaha developments",
    blurb: "Travel notes, typical bedrooms and booking timing for The Ridges, The Sanctuary, Linden Estates, Tiburon, Eagle Run, Champions Run and Regency.",
    guides: list(import.meta.glob<Mod>("./developments/*.md", { eager: true })),
  },
];

const items = hubs.flatMap((h) => [
  { name: h.name, url: `${SITE}${h.path}` },
  ...h.guides.map((g) => ({ name: g.h1, url: `${SITE}${h.path}/${g.slug}` })),
]);
const URL_ = `${SITE}/knowledge-center`;
const modified = kcLastmod(hubs.flatMap((h) => h.guides));
const jsonld = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${URL_}#page`,
    name: "Omaha Mattress Cleaning Knowledge Center",
    url: URL_,
    dateModified: modified,
    isPartOf: { "@type": "WebSite", url: SITE, name: "Omaha Mattress Cleaning & Sanitation" },
    publisher: { "@type": "LocalBusiness", "@id": "https://sleepsanitation.com/#business", name: "Sleep Sanitation" },
    breadcrumb: { "@id": `${URL_}#breadcrumb` },
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: items.length,
      itemListElement: items.map((it, i) => ({ "@type": "ListItem", position: i + 1, name: it.name, url: it.url })),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${URL_}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
      { "@type": "ListItem", position: 2, name: "Knowledge Center", item: URL_ },
    ],
  },
];
const guideCount = hubs.reduce((n, h) => n + h.guides.length, 0);
---
<Base title="Omaha Mattress Knowledge Center | Local Guides and Hubs" description={`${guideCount} Omaha guides in 5 hubs: Omaha homes, suburbs, allergy season, Airbnb hosts and named developments. Operated by Sleep Sanitation.`} path="/knowledge-center" jsonld={jsonld}>
  <style>
    .hub { border-top:1px solid var(--line); padding-top:1.2rem; margin-top:2rem; }
    .hub ul { margin:.6rem 0 0; }
  </style>
  <section class="section" style="padding-top:3rem;">
    <div class="container prose">
      <p style="font-size:0.9rem;"><a href="/">Home</a> › Knowledge Center</p>
      <span class="eyebrow">Knowledge Center</span>
      <h1>Omaha Mattress Cleaning Knowledge Center</h1>
      <p class="lead">This Knowledge Center collects our Omaha-specific guides: mattress disposal and bed bugs, the suburbs we serve, allergy season, hosting short-term rentals and named developments. Omaha Mattress Cleaning & Sanitation is operated by Sleep Sanitation. The first mattress is {priceText.first}, any size; see <a href="/pricing">our pricing page</a> for every rate. Call or text <a href={PHONE.tel}>{PHONE.display}</a>.</p>

      {hubs.map((h) => (
        <div class="hub">
          <h2>{h.q}</h2>
          <p><a href={h.path}><strong>{h.name}</strong></a>: {h.blurb}</p>
          <ul>
            {h.guides.map((g) => <li><a href={`${h.path}/${g.slug}`}>{g.h1}</a></li>)}
          </ul>
        </div>
      ))}

      <div class="hub">
        <h2>Where are the general mattress guides?</h2>
        <p>Cleaning methods, mattress materials, moisture and bed mites aren't specific to Omaha, so they live in the parent company's library, the <a href="https://sleepsanitation.com/knowledge-center">Sleep Sanitation Knowledge Center</a>.</p>
      </div>
      <p><a class="btn btn-primary" href="/book">Book or contact us</a></p>
    </div>
  </section>
</Base>
