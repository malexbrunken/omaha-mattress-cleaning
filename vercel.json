{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/airbnb-hosts/nebraska-law-hoa-covenants-and-omaha", "destination": "/airbnb-hosts/omaha-lodging-taxes-and-direct-bookings", "statusCode": 301 }
  ],
  "crons": [{ "path": "/api/indexnow", "schedule": "23 13 * * *" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
